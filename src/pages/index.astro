---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/v4/Header.astro";
import Hero from "@/components/v4/Hero.astro";
import About from "@/components/v4/About.astro";
import Experience from "@/components/v4/Experience.astro";
import UseCase from "@/components/v4/UseCase.astro";
import Architecture from "@/components/v4/Architecture.astro";
import Harness from "@/components/v4/Harness.astro";
import Capabilities from "@/components/v4/Capabilities.astro";
import Projects from "@/components/v4/Projects.astro";
import Documents from "@/components/v4/Documents.astro";
import Stack from "@/components/v4/Stack.astro";
import Education from "@/components/v4/Education.astro";
import Contact from "@/components/v4/Contact.astro";
import Footer from "@/components/v4/Footer.astro";
import Mesa from "@/components/v4/Mesa.astro";
// Paleta, email, capacidades, filtros, lectura, nav activo y cielo del inicio. Va antes que el de la mesa.
import mainJs from "@/scripts/main.js?raw";
import { cv } from "@/lib/cv";
import { META_DESCRIPTION } from "@/data/site";
---

<Layout title={cv.basics.name} description={META_DESCRIPTION}>
  <div class="readbar" aria-hidden="true"><span id="readbar"></span></div>
  <Header />

  <main>
    <Hero />
    <About />
    <Experience />
    <UseCase />
    <Architecture />
    <Harness />
    <Capabilities />
    <Projects />
    <Documents />
    <Stack />
    <Education />
    <Contact />
  </main>
  <a class="totop" id="totop" href="#inicio" aria-label="Volver arriba"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5"></path><path d="m5 12 7-7 7 7"></path></svg></a>

  <Footer />

  <script is:inline set:html={mainJs} />
  <Mesa />
</Layout>
