---
import { ICONS } from "@/data/icons";

// Icono de cv.json (mdi:…, simple-icons:…, ri:…) o uno de trazo propio ("download", "search").
interface Props {
  name: string;
  class?: string;
}

const STROKE: Record<string, string> = {
  download: '<path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/>',
  search: '<circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.4-4.4"/>',
};

const { name, class: cls = "ic" } = Astro.props;
const stroke = STROKE[name];
const body = ICONS[name];
---

{
  stroke ? (
    <svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={stroke} />
  ) : body ? (
    <svg class={cls} viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" set:html={body} />
  ) : null
}
